# Copy to .env (git-ignored) and fill in. Load it with:  set -a; source .env; set +a
# Database the jobs read and write. Local example below; production uses the GDR_DATABASE_URL GitHub secret.
GDR_DATABASE_URL=postgres://USER@localhost:5432/gamedealradar?sslmode=disable
# API key for the price data provider, used only by cmd/epic-prices. Leave empty unless you run that job locally.
ITAD_API_KEY=
